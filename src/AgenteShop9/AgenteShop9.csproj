<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgenteShop9</RootNamespace>
    <AssemblyName>AgenteShop9</AssemblyName>
    <Version>1.1.0</Version>
    <!-- ISSUE #7: NAO ligar InvariantGlobalization. O Microsoft.Data.SqlClient
         nao suporta esse modo e estoura NotSupportedException em SqlConnection.Open. -->
    <!-- Publicacao para o servidor Windows do cliente (um .exe so): ver agente/README.md -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <!-- Item 4.1 (issue #48): HttpClient tipado para BaixadorCatalogo baixar o
         catalogo assinado do backend (IHttpClientFactory cuida do ciclo de
         vida/DNS — o robo roda dias/semanas como servico do Windows). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <!-- Validacao integral de PNG/JPEG no agente Windows antes de indexar midia publica. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.*" />
  </ItemGroup>

</Project>
