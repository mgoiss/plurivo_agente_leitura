<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Kestrel para o "backend de mentira" do teste de integracao (servidor WebSocket local). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgenteShop9\AgenteShop9.csproj" />
  </ItemGroup>

  <!-- Catalogo de exemplo ja assinado (testes/fixtures/), usado como fixture real. -->
  <ItemGroup>
    <None Include="..\fixtures\catalogo.json"
          Link="fixtures\catalogo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\catalogo.json.minisig"
          Link="fixtures\catalogo.json.minisig" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\catalogo\catalogo.candidato-configuracao.json" Link="fixtures\catalogo.candidato-configuracao.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\catalogo\catalogo.candidato-publico.json" Link="fixtures\catalogo.candidato-publico.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\catalogo\catalogo.candidato-aceleracao-imagens.json" Link="fixtures\catalogo.candidato-aceleracao-imagens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\catalogo\catalogo.json"
          Link="fixtures\catalogo-real.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
